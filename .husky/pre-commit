#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run prettier check (don't modify yet)
if ! npx prettier --check .; then
  echo "Formatting issues found. Fixing with prettier..."
  npx prettier --write .
  echo "Files have been formatted. Review and stage changes before committing."
  exit 1
fi

# Run lint
if ! npm run lint; then
  exit 1
fi